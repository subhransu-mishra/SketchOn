# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/whiteboard-ai

# Clerk Authentication (get from https://clerk.com)
CLERK_SECRET_KEY=sk_test_your_test_key_here

# Server Configuration
PORT=4000
NODE_ENV=development

# Anthropic AI (for diagram analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Resend API Key (get from https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here

# Clerk Webhook Secret (get from Clerk Dashboard -> Webhooks -> Signing Secret)
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_secret_here

# Frontend Application URL (for email CTA buttons)
APP_URL=http://localhost:5173

# Production example:
# CLERK_SECRET_KEY=sk_live_your_production_key_here
# CLERK_WEBHOOK_SECRET=whsec_your_production_webhook_secret_here
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/whiteboard-ai
# NODE_ENV=production
# APP_URL=https://your-production-app.com